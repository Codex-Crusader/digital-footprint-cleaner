# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environment
venv/
ENV/
env/
.venv/

# PyCharm project files
.idea/
*.iml

# Flask cache files
instance/
*.log
flask.log

# duckduckgo-search / ddgs on-disk cache
vqd_cache/

# Distribution / packaging
build/
dist/
*.egg-info/

# HTML temporary/backup
*.swp
*.bak
*~

# Environment variables and config
.env
.env.*
!.env.example

# OS-specific files
.DS_Store
Thumbs.db

# JSON data you don’t want uploaded (optional)
data/*.json
# ...but do ship the curated data files that ARE part of the app
!data/services.json
!data/brokers.json

# Jupyter notebooks (if used in future)
*.ipynb_checkpoints

# Testing / linting caches and coverage data
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Editor-specific files
.vscode/
*.sublime-project
*.sublime-workspace

# Security files
*.key

# Database files (if applicable)
*.csv
*.db
*.sqlite3
