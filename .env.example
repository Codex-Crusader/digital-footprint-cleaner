# Copy this file to `.env` and adjust for your environment.
# These values are read from the process environment. The app does not load
# `.env` automatically; export them in your shell or use your process manager,
# e.g. on PowerShell:  $env:SECRET_KEY = "..."   or  export SECRET_KEY=... on bash.

# Flask secret key used to sign session cookies. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates a random ephemeral key and sessions reset on restart.
SECRET_KEY=

# Set to "development" to enable Flask debug mode (auto-reload + debugger).
# Leave as "production" (the default) for any real deployment.
FLASK_ENV=production

# Send session cookies only over HTTPS. Set to "true" in production behind TLS.
# Keep "false" for local HTTP development.
SESSION_COOKIE_SECURE=false

# Search rate limiting (per client IP, per process).
# Max searches allowed within the window, and the window length in seconds.
SEARCH_RATE_LIMIT=10
SEARCH_RATE_WINDOW=60
