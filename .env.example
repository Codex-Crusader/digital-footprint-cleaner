# Copy this file to `.env` and adjust for your environment.
# These values are read from the process environment. The app does not load
# `.env` automatically; export them in your shell or use your process manager,
# e.g. on PowerShell:  $env:SECRET_KEY = "..."   or  export SECRET_KEY=... on bash.

# Flask secret key used to sign session cookies. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates a random ephemeral key and sessions reset on restart.
SECRET_KEY=

# Set to "development" to enable Flask debug mode (auto-reload + debugger).
# Leave as "production" (the default) for any real deployment.
FLASK_ENV=production

# Send session cookies only over HTTPS. Set to "true" in production behind TLS.
# Keep "false" for local HTTP development.
SESSION_COOKIE_SECURE=false

# Search rate limiting (per client IP, per process).
# Budget is counted in tokens, not requests: an endpoint is charged roughly one
# token per upstream request it makes. A deep scan is charged the size of its
# own query plan (~17 searches at "deep"), and the broker sweep, email check and
# username check each cost several. The default is sized for one realistic
# session: one deep scan, one broker sweep, one email check, one username check.
SEARCH_RATE_LIMIT=70
SEARCH_RATE_WINDOW=60

# Pacing for the shared search gate. Every upstream search (deep-scan pass,
# broker check, plain scan) waits at this gate, which enforces a minimum
# interval between request starts and a ceiling on concurrency. It widens itself
# automatically when the backend signals throttling and narrows again on
# success, so these are starting points rather than hard limits.
#
# Raising concurrency does NOT make scans faster: DuckDuckGo throttles parallel
# bursts, so more workers returns less data, not more.
SEARCH_MIN_INTERVAL=0.35
SEARCH_MAX_CONCURRENCY=3

# Wall-clock budget, in seconds, for a whole deep scan. Passes run in
# significance order and whatever is unreached when the budget expires is
# reported as "skipped" rather than silently dropped, so a slow backend degrades
# coverage instead of hanging the request.
DEEP_SEARCH_BUDGET=40

# Optional GitHub API token for the "accounts by email" signal.
# Without it GitHub's search API allows only ~10 requests per minute for the
# whole process, so that probe will usually report "unknown" rather than a
# result. A token with NO scopes is enough: this only reads public search.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Access control ---------------------------------------------------------
# Passcode lock. When either of these is set, every page requires a login first.
# Optional by design: the app is bound to localhost and already refuses requests
# that are not addressed to it, so a passcode is a second layer rather than the
# only one. Set it if anyone else can reach this machine.
#
# DFC_PASSCODE_HASH is preferred: it keeps the plaintext out of the environment,
# and therefore out of shell history and process listings. Generate one with:
#   python -c "from utils.auth import hash_passcode; print(hash_passcode('your passcode'))"
DFC_PASSCODE_HASH=

# Convenience alternative: the plaintext passcode, hashed at startup.
DFC_PASSCODE=

# How long an unlocked session may sit idle, in seconds, before it locks again.
DFC_IDLE_TIMEOUT=1800

# Extra hostnames this app will answer to, comma separated. localhost, 127.0.0.1
# and ::1 are always allowed. Requests naming anything else are refused, which is
# what stops a malicious web page from reaching this app through DNS rebinding.
# Only add a name here if you deliberately serve the app under it.
DFC_ALLOWED_HOSTS=

# Where the removal-request tracker stores its local SQLite database.
# Defaults to instance/tracker.sqlite3 (gitignored). This file records which
# sites you have asked to remove you, so keep it local and back it up
# deliberately, or not at all.
DFC_DB_PATH=
